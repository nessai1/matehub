# MateHub edge -- TLS termination + API path routing.
#
# Static SPA is no longer served by Caddy: it's baked into the hub image
# and served by tower-http ServeDir as a fallback. The default `handle`
# block forwards everything that didn't match an API prefix to hub, which
# returns either an API response (if the path matches /v1/* or /ws/*) or a
# static asset / index.html (everything else).
#
# `handle_path` strips the matched prefix before forwarding, so each
# upstream sees its own native path layout (`/v1/...`, `/ws/...`).

{
    email {$ACME_EMAIL}
}

{$DOMAIN} {
    encode zstd gzip

    # ── hub: REST + presence WebSocket ─────────────────────────────
    handle_path /api/hub/* {
        reverse_proxy hub:3002
    }

    # ── chat: REST + gateway WebSocket ─────────────────────────────
    handle_path /api/chat/* {
        reverse_proxy chat:3003
    }

    # ── video: SFU signalling (REST + /ws/{session_id}) ────────────
    # Media itself is UDP straight to host:4001, not through Caddy.
    handle_path /api/video/* {
        reverse_proxy video:4000
    }

    # ── SPA + everything else → hub (ServeDir fallback) ────────────
    handle {
        reverse_proxy hub:3002
    }
}
