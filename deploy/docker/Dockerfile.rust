# MateHub services -- single multi-target Dockerfile.
#
# Per-build the user picks ONE service via two coordinated knobs:
#   --build-arg SERVICE=hub   -- tells the Rust builder which crate to compile
#   --target hub              -- tells BuildKit which final stage to assemble
#
# Both must match. Mismatched values produce a "matehub-X not found" copy
# error at the final stage, which is the desired loud failure.
#
# Targets / SERVICE values:
#   hub         -- API + Vite SPA bundle + migrations
#   chat        -- API only
#   video       -- SFU (str0m, needs libssl)
#   transcoder  -- ffmpeg worker
#   general     -- SaaS control plane + migrations + mail templates
#
# Usage from GitHub Actions (release.yml does this automatically):
#   build:
#     context: .
#     dockerfile: deploy/docker/Dockerfile.rust
#     target: hub
#     build-args:
#       SERVICE: hub
#
# Rust targets stay on debian-slim because str0m needs OpenSSL at runtime.

# Global ARG so it's visible after FROM in stages that re-declare it.
ARG SERVICE

# ── Frontend builder (Vite SPA, baked into hub) ──────────────────────
# Built unconditionally -- BuildKit only assembles stages reachable from
# the chosen --target, so non-hub builds skip this layer entirely.
FROM node:22-alpine AS frontend-builder

WORKDIR /app

# npm workspace manifests first so the install layer caches.
COPY package.json package-lock.json ./
COPY packages/sdk-video/package.json packages/sdk-video/package.json
COPY packages/sdk-chat/package.json packages/sdk-chat/package.json
COPY frontend/package.json frontend/package.json

RUN npm ci

# Source.
COPY packages packages
COPY frontend frontend

# Build is deterministic: API URLs are same-origin (/api/hub, /api/chat,
# /api/video) and TURN/app config is fetched from hub at runtime via
# /config.json. Same image runs on any deployment.
WORKDIR /app/frontend
RUN npm run build

# ── Rust builder ─────────────────────────────────────────────────────
# Match /rust-toolchain.toml so rustup doesn't have to download a second
# toolchain on top of the base image's bundled one.
FROM rust:1.95-bookworm AS builder
ARG SERVICE
# Release tag like "0.1.2", baked into the binary via option_env!() so
# /version reports the same string the image is tagged with. Falls back
# to CARGO_PKG_VERSION when unset (local builds, dev compose).
ARG VERSION
ENV MATEHUB_VERSION=${VERSION}

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends pkg-config libssl-dev && \
    rm -rf /var/lib/apt/lists/*

# Workspace manifests + shared crate first so the dep layer caches.
# All five Cargo.toml files are required even if we only build one service:
# Cargo refuses to operate on an incomplete workspace.
COPY Cargo.toml Cargo.lock ./
COPY packages/common-rust packages/common-rust
COPY services/hub/Cargo.toml        services/hub/Cargo.toml
COPY services/chat/Cargo.toml       services/chat/Cargo.toml
COPY services/video/Cargo.toml      services/video/Cargo.toml
COPY services/general/Cargo.toml    services/general/Cargo.toml
COPY services/transcoder/Cargo.toml services/transcoder/Cargo.toml

# Stub mains for every workspace member -- needed to make the workspace
# valid before we have real sources. They get overwritten only for the
# target service below; the others stay as stubs and are never compiled.
RUN mkdir -p services/hub/src services/chat/src services/video/src \
             services/general/src services/transcoder/src && \
    for s in hub chat video general transcoder; do \
        echo "fn main() {}" > services/$s/src/main.rs; \
    done

# Pre-build dependencies for the target service. `|| true` because the
# dep-only graph technically can't link (no real main), but the side-
# effect we want -- compiled crates in target/release/deps -- happens
# anyway, and that's what the next layer caches.
RUN cargo build --release -p matehub-${SERVICE} || true

# Real source for ONE service. Changes to other services don't invalidate
# this layer. Includes src/, plus migrations/ and templates/ for services
# that have them (hub, general).
COPY services/${SERVICE} services/${SERVICE}

# Touch main so cargo rebuilds the leaf crate, not the cached deps.
RUN touch services/${SERVICE}/src/main.rs && \
    cargo build --release -p matehub-${SERVICE}

# ── Common runtime base (debian-slim + libssl) ───────────────────────
FROM debian:bookworm-slim AS runtime-base

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates libssl3 curl && \
    rm -rf /var/lib/apt/lists/*

ENV RUST_LOG=info

# ── hub (binary + migrations + Vite SPA bundle) ──────────────────────
FROM runtime-base AS hub

COPY --from=builder           /app/target/release/matehub-hub /usr/local/bin/matehub-hub
COPY --from=builder           /app/services/hub/migrations    /var/lib/matehub/migrations
COPY --from=frontend-builder  /app/frontend/dist              /srv/dist

ENV STATIC_DIR=/srv/dist

EXPOSE 3002

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 \
    CMD curl -fsS http://localhost:3002/health || exit 1

ENTRYPOINT ["matehub-hub"]

# ── chat ─────────────────────────────────────────────────────────────
FROM runtime-base AS chat

COPY --from=builder /app/target/release/matehub-chat /usr/local/bin/matehub-chat

EXPOSE 3003

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 \
    CMD curl -fsS http://localhost:3003/health || exit 1

ENTRYPOINT ["matehub-chat"]

# ── video ────────────────────────────────────────────────────────────
FROM runtime-base AS video

COPY --from=builder /app/target/release/matehub-video /usr/local/bin/matehub-video

# 4000 = HTTP/WS signaling, 4001/udp = SFU media (str0m).
EXPOSE 4000/tcp
EXPOSE 4001/udp

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 \
    CMD curl -fsS http://localhost:4000/health || exit 1

ENTRYPOINT ["matehub-video"]

# ── transcoder (NATS worker, ffmpeg in PATH) ─────────────────────────
FROM runtime-base AS transcoder

RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/matehub-transcoder /usr/local/bin/matehub-transcoder

ENTRYPOINT ["matehub-transcoder"]

# ── general (SaaS control plane) ─────────────────────────────────────
FROM runtime-base AS general

COPY --from=builder /app/target/release/matehub-general /usr/local/bin/matehub-general
COPY --from=builder /app/services/general/migrations    /var/lib/matehub/migrations
COPY --from=builder /app/services/general/templates     /var/lib/matehub/templates

EXPOSE 3001

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 \
    CMD curl -fsS http://localhost:3001/health || exit 1

ENTRYPOINT ["matehub-general"]
