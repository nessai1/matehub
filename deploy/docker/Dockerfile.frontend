## matehub-frontend -- Next.js standalone build

FROM node:22-alpine AS builder

WORKDIR /app

# Root workspace files
COPY package.json package-lock.json ./

# SDK packages (frontend depends on them via workspace)
COPY packages/sdk-video/package.json packages/sdk-video/package.json
COPY packages/sdk-chat/package.json packages/sdk-chat/package.json

# Frontend
COPY frontend/package.json frontend/package.json

RUN npm ci

# Copy SDK source
COPY packages/ packages/

# Copy frontend source
COPY frontend/ frontend/

# Build
WORKDIR /app/frontend
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# Runtime
FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=builder /app/frontend/.next/standalone ./
COPY --from=builder /app/frontend/.next/static ./.next/static
COPY --from=builder /app/frontend/public ./public

EXPOSE 3000

CMD ["node", "server.js"]
