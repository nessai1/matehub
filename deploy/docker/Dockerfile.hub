## matehub-hub -- multi-stage build

FROM rust:1.87-bookworm AS builder

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY services/video/Cargo.toml services/video/Cargo.toml
COPY services/chat/Cargo.toml services/chat/Cargo.toml
COPY services/hub/Cargo.toml services/hub/Cargo.toml

RUN mkdir -p services/video/src services/chat/src services/hub/src && \
    echo "fn main() {}" > services/video/src/main.rs && \
    echo "fn main() {}" > services/chat/src/main.rs && \
    echo "fn main() {}" > services/hub/src/main.rs

RUN cargo build --release -p matehub-hub 2>/dev/null || true

COPY services/hub/src services/hub/src
RUN touch services/hub/src/main.rs && \
    cargo build --release -p matehub-hub

FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates libssl3 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/matehub-hub /usr/local/bin/matehub-hub

EXPOSE 3002/tcp

ENV RUST_LOG=info

ENTRYPOINT ["matehub-hub"]
