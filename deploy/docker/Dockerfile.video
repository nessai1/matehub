## matehub-video -- multi-stage build
## str0m requires OpenSSL (libssl)

FROM rust:1.87-bookworm AS builder

WORKDIR /app

# Cache dependencies: copy manifests first, build deps, then copy source
COPY Cargo.toml Cargo.lock ./
COPY services/video/Cargo.toml services/video/Cargo.toml
COPY services/chat/Cargo.toml services/chat/Cargo.toml
COPY services/general/Cargo.toml services/general/Cargo.toml

# Create dummy source files for dependency caching
RUN mkdir -p services/video/src services/chat/src services/general/src && \
    echo "fn main() {}" > services/video/src/main.rs && \
    echo "fn main() {}" > services/chat/src/main.rs && \
    echo "fn main() {}" > services/general/src/main.rs

# Build dependencies only (cached layer)
RUN cargo build --release -p matehub-video 2>/dev/null || true

# Copy real source and rebuild
COPY services/video/src services/video/src
RUN touch services/video/src/main.rs && \
    cargo build --release -p matehub-video

# Runtime image -- slim debian (str0m needs libssl)
FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates libssl3 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/matehub-video /usr/local/bin/matehub-video

# SFU needs UDP ports
EXPOSE 3000/tcp
# 3000 = signaling WS + API
# UDP media ports are ephemeral, configured at runtime

ENV RUST_LOG=info

ENTRYPOINT ["matehub-video"]
