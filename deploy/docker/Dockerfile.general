## matehub-general -- multi-stage build

FROM rust:1.87-bookworm AS builder

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY services/video/Cargo.toml services/video/Cargo.toml
COPY services/chat/Cargo.toml services/chat/Cargo.toml
COPY services/general/Cargo.toml services/general/Cargo.toml

RUN mkdir -p services/video/src services/chat/src services/general/src && \
    echo "fn main() {}" > services/video/src/main.rs && \
    echo "fn main() {}" > services/chat/src/main.rs && \
    echo "fn main() {}" > services/general/src/main.rs

RUN cargo build --release -p matehub-general 2>/dev/null || true

COPY services/general/src services/general/src
RUN touch services/general/src/main.rs && \
    cargo build --release -p matehub-general

FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates libssl3 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/matehub-general /usr/local/bin/matehub-general

EXPOSE 3002/tcp

ENV RUST_LOG=info

ENTRYPOINT ["matehub-general"]
