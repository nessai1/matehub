# MateHub boxed deploy -- environment template.
#
# Copy to `.env` and fill in DOMAIN/PUBLIC_IP/ACME_EMAIL by hand.
# Empty secrets (POSTGRES_PASSWORD, JWT_SECRET, S3_SECRET_KEY, TURN_PASSWORD)
# are auto-generated by scripts/box-deploy.sh on first run.

# ── Required: filled in by hand ────────────────────────────────────

# Public hostname pointed at this VPS via DNS A-record.
DOMAIN=dima.matehub.io

# Server's public IPv4. str0m advertises this as the SFU host candidate
# and coturn uses it as `--external-ip`. Without it WebRTC will not connect.
PUBLIC_IP=

# Used by Caddy for Let's Encrypt registration. Goes into ACME contact
# field, gets cert-expiry warnings.
ACME_EMAIL=

# ── Auto-generated on first run (leave blank) ──────────────────────

POSTGRES_PASSWORD=
JWT_SECRET=
S3_ACCESS_KEY=matehub
S3_SECRET_KEY=
TURN_USERNAME=matehub
TURN_PASSWORD=

# ── Optional ───────────────────────────────────────────────────────

# tracing-subscriber filter. `info` is sane; `debug,tower=info,sqlx=warn`
# helps when debugging.
RUST_LOG=info
