# MateHub box deployment -- environment template.
# Copy to .env and fill in. Never commit the real .env.

# ── Domain & TLS ─────────────────────────────────────────
# DNS A-record for DOMAIN must already point at PUBLIC_IP before the
# stack is started -- Let's Encrypt's HTTP-01 challenge needs the host
# to be reachable on port 80.
DOMAIN=demo.matehub.io
PUBLIC_IP=YOUR.PUBLIC.IP.HERE
ACME_EMAIL=you@example.com

# ── Container registry ───────────────────────────────────
# Full prefix that gets concatenated with /matehub-<service>:<version>.
# Defaults to our YC CR. Override if you mirror the images elsewhere
# (private registry, Docker Hub, internal Harbor, etc.).
REGISTRY_URL=cr.yandex/crpmeie5vbl95i4giob6

# ── Image versions ───────────────────────────────────────
# These tags must already exist in the registry, pushed by release.yml.
# Bump per service to roll out an update.
HUB_VERSION=0.1.0
CHAT_VERSION=0.1.0
VIDEO_VERSION=0.1.0
TRANSCODER_VERSION=0.1.0

# ── Application secrets ──────────────────────────────────
# Generate locally, never reuse across environments:
#   openssl rand -hex 32
# Both hub and chat sign/verify JWTs against JWT_SECRET; if you rotate
# it, every existing session is invalidated -- restart the whole stack.
POSTGRES_PASSWORD=
JWT_SECRET=
S3_ACCESS_KEY=matehub
S3_SECRET_KEY=

# ── S3 public URL ────────────────────────────────────────
# Override only when you point matehub at an external object store
# (AWS S3, public Yandex Cloud Object Storage, etc.). For the bundled
# MinIO this stays blank and compose substitutes the default
# `https://${DOMAIN}/s3` so Caddy proxies `/s3/*` → `minio:9000`. The
# browser must be able to GET assets at `S3_PUBLIC_URL/<bucket>/<key>`.
S3_PUBLIC_URL=

# ── TURN (relay for symmetric-NAT clients) ───────────────
# TURN_URL is surfaced to the SPA via hub's /config.json -- the bundle
# itself doesn't know the domain, so the same image is portable across
# deployments. Compose substitutes ${DOMAIN} below at startup.
TURN_URL=turn:${DOMAIN}:3478?transport=udp
TURN_USERNAME=matehub
TURN_PASSWORD=

# ── Observability (optional, --profile observability) ───
# Filled by setup.sh only when the operator opts in. Leave blank otherwise
# — the stack stays down and the /grafana, /kibana routes 502 in Caddy.
#
# OBSERVABILITY_USER / OBSERVABILITY_PASSWORD_HASH gate the basicauth in
# front of Grafana and Kibana. Hash is bcrypt; generate with
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<pwd>'
# OBSERVABILITY_PASSWORD is the plaintext, surfaced after setup so you
# can write it down — never read by any service at runtime.
OBSERVABILITY_USER=admin
# Plaintext is intentionally NOT a field here. Caddy reads only the
# bcrypt hash below; the plaintext is shown once on stdout by setup.sh
# with a "write this down" banner, and never persisted on disk.
OBSERVABILITY_PASSWORD_HASH=

# Grafana's built-in admin (separate from the Caddy basicauth above —
# the basicauth only proves you can reach Grafana at all, this is the
# Grafana account that creates dashboards / users).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── Misc ─────────────────────────────────────────────────
RUST_LOG=info
