# MateHub box deployment -- environment template.
# Copy to .env and fill in. Never commit the real .env.

# ── Domain & TLS ─────────────────────────────────────────
# DNS A-record for DOMAIN must already point at PUBLIC_IP before the
# stack is started -- Let's Encrypt's HTTP-01 challenge needs the host
# to be reachable on port 80.
DOMAIN=demo.matehub.io
PUBLIC_IP=YOUR.PUBLIC.IP.HERE
ACME_EMAIL=you@example.com

# ── Container registry ───────────────────────────────────
# Full prefix that gets concatenated with /matehub-<service>:<version>.
# Defaults to our YC CR. Override if you mirror the images elsewhere
# (private registry, Docker Hub, internal Harbor, etc.).
REGISTRY_URL=cr.yandex/crpmeie5vbl95i4giob6

# ── Image versions ───────────────────────────────────────
# These tags must already exist in the registry, pushed by release.yml.
# Bump per service to roll out an update.
HUB_VERSION=0.1.0
CHAT_VERSION=0.1.0
VIDEO_VERSION=0.1.0
TRANSCODER_VERSION=0.1.0

# ── Application secrets ──────────────────────────────────
# Generate locally, never reuse across environments:
#   openssl rand -hex 32
# Both hub and chat sign/verify JWTs against JWT_SECRET; if you rotate
# it, every existing session is invalidated -- restart the whole stack.
POSTGRES_PASSWORD=
JWT_SECRET=
S3_ACCESS_KEY=matehub
S3_SECRET_KEY=

# ── TURN (relay for symmetric-NAT clients) ───────────────
# TURN_URL is surfaced to the SPA via hub's /config.json -- the bundle
# itself doesn't know the domain, so the same image is portable across
# deployments. Compose substitutes ${DOMAIN} below at startup.
TURN_URL=turn:${DOMAIN}:3478?transport=udp
TURN_USERNAME=matehub
TURN_PASSWORD=

# ── Misc ─────────────────────────────────────────────────
RUST_LOG=info
