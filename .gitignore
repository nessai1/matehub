# Rust
/target/
# Desktop app — отдельный workspace со своим target (Cargo.lock коммитится,
# как и корневой: бинарная поставка = воспроизводимая сборка).
apps/desktop-share/src-tauri/target/
apps/desktop-share/src-tauri/gen/
# Cargo.lock IS committed: this workspace ships binaries (services/*) and
# every CI/release build must use the exact dependency versions we tested
# locally. Only library crates published to crates.io should ignore it.

# Node
node_modules/
dist/
.next/
out/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.local
.env.*.local

# Logs
*.log

# ROOM_DEBUG=1 per-call capture output (server ndjson + client bundles).
# Local debugging artifacts — never committed.
room-debug/

# Box-deploy credential. Lives at scripts/box/puller.json for local
# pack-archive runs; the file itself is a YC SA pull-only key file and
# must NEVER be committed. CI builds materialise it from the
# `YC_PULLER_KEY` repo secret instead.
scripts/box/puller.json
